{
  "openapi": "3.1.0",
  "info": {
    "title": "Geomacro x402 Testnet Intelligence API",
    "version": "1.0.0-testnet",
    "description": "Structured, derived intelligence only. Raw source data is never delivered through this API."
  },
  "servers": [{ "url": "https://geomacro.live" }],
  "paths": {
    "/api/x402/intelligence": {
      "get": {
        "summary": "Describe the x402 intelligence product",
        "responses": { "200": { "description": "Current testnet product metadata" } }
      },
      "post": {
        "summary": "Buy structured Geomacro intelligence per call",
        "description": "A deliverable unpaid request returns HTTP 402 with PAYMENT-REQUIRED. After valid x402 testnet payment, the same bound query returns structured derived intelligence.",
        "parameters": [
          {
            "name": "PAYMENT-SIGNATURE",
            "in": "header",
            "required": false,
            "schema": { "type": "string" },
            "description": "x402 v2 payment payload used on the paid retry."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/AgentQuery" },
              "examples": {
                "geopolitics": {
                  "value": {
                    "question": "Assess current geopolitical and sanctions risk for China",
                    "subjects": [{ "type": "country", "country_iso3": "CHN" }],
                    "topics": ["conflict_geopolitics", "sanctions_restrictions"],
                    "detail": "standard",
                    "evidence": "required"
                  }
                },
                "macroeconomics": {
                  "value": {
                    "question": "Assess current macro and FX risk for India",
                    "subjects": [{ "type": "country", "country_iso3": "IND" }],
                    "topics": ["macro_risk", "fx_external_risk"],
                    "detail": "standard",
                    "evidence": "required"
                  }
                },
                "critical_minerals": {
                  "value": {
                    "question": "Assess current critical-minerals risk for China",
                    "subjects": [{ "type": "country", "country_iso3": "CHN" }],
                    "topics": ["critical_minerals"],
                    "detail": "standard",
                    "evidence": "required"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Paid structured intelligence response. execution_authorized is always false.",
            "headers": {
              "PAYMENT-RESPONSE": { "schema": { "type": "string" } }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/StructuredIntelligenceResponse" }
              }
            }
          },
          "402": {
            "description": "Payment required for a request that already passed no-charge deliverability validation.",
            "headers": {
              "PAYMENT-REQUIRED": { "required": true, "schema": { "type": "string" } }
            }
          },
          "422": {
            "description": "Requested intelligence is not currently fully deliverable; no payment is accepted."
          },
          "429": { "description": "Intentional rate limit" }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AgentQuery": {
        "type": "object",
        "additionalProperties": false,
        "required": ["subjects"],
        "properties": {
          "schema_version": { "type": "string", "const": "geomacro.agent-query.v1" },
          "question": { "type": "string", "minLength": 3, "maxLength": 2000 },
          "subjects": {
            "type": "array",
            "minItems": 1,
            "maxItems": 25,
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["type", "country_iso3"],
                  "properties": {
                    "type": { "const": "country" },
                    "country_iso3": { "type": "string", "pattern": "^[A-Z]{3}$" }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["type", "origin_country_iso3", "destination_country_iso3"],
                  "properties": {
                    "type": { "const": "corridor" },
                    "origin_country_iso3": { "type": "string", "pattern": "^[A-Z]{3}$" },
                    "destination_country_iso3": { "type": "string", "pattern": "^[A-Z]{3}$" }
                  }
                }
              ]
            }
          },
          "topics": {
            "type": "array",
            "items": {
              "enum": [
                "macro_risk",
                "fx_external_risk",
                "sanctions_restrictions",
                "conflict_geopolitics",
                "critical_minerals",
                "trade_corridor",
                "energy_commodities",
                "political_governance",
                "hot_topics",
                "risk_gate",
                "risk_object",
                "gri_context"
              ]
            }
          },
          "max_age_seconds": { "type": "integer", "minimum": 1 },
          "evidence": { "enum": ["required", "summary"] },
          "detail": { "enum": ["compact", "standard", "full"] },
          "client_request_id": { "type": "string", "minLength": 4, "maxLength": 128 }
        }
      },
      "StructuredIntelligenceResponse": {
        "type": "object",
        "required": ["schema_version", "product", "request_id", "query_plan_hash", "subjects", "answer", "limitations", "execution_authorized", "delivered_product_hash", "payment"],
        "properties": {
          "schema_version": { "type": "string" },
          "product": { "type": "string" },
          "request_id": { "type": "string" },
          "query_plan_hash": { "type": "string" },
          "subjects": { "type": "array", "items": { "type": "object" } },
          "answer": { "type": "object" },
          "current_state": { "type": "array", "items": { "type": "object" } },
          "structural": { "type": "array", "items": { "type": "object" } },
          "hot_topics": { "type": "array", "items": { "type": "object" } },
          "signed_risk_objects": { "type": "array", "items": { "type": "object" } },
          "gri_context": { "type": ["object", "null"] },
          "limitations": { "type": "object" },
          "payment": { "type": "object" },
          "execution_authorized": { "type": "boolean", "const": false },
          "delivered_product_hash": { "type": "string" }
        }
      }
    }
  },
  "x-geomacro": {
    "environment": "testnet",
    "domains": ["geopolitics", "macroeconomics", "critical_minerals"],
    "raw_data_delivery": false,
    "delivery_format": "structured-derived-intelligence-only",
    "x402_version": 2,
    "asset": "USDC",
    "execution_authorized": false
  }
}
