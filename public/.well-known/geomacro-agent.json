      "execution_authorized": false
    },
    {
      "id": "adaptive_risk_intelligence",
      "access": "prelaunch_x402_or_provider_sandbox",
      "question_preflight_endpoint": "https://geomacro.live/api/agent/question-preflight",
      "availability_endpoint": "https://geomacro.live/api/x402/risk/availability",
      "paid_endpoint": "https://geomacro.live/api/x402/intelligence",
      "question_only_supported_via_preflight": true,
      "commerce_catalog": "https://geomacro.live/.well-known/geomacro-commerce.json",
      "content_type": "application/json",
      "execution_authorized": false
    }
  ],
  "grounding": {
    "stored_geomacro_intelligence": true,
    "current_public_risk_indices": true,
    "canonical_public_gri": true,
    "canonical_public_gri_role": "parent_gri_v1_2_compatibility_context",
    "commercial_source_eligibility_required_for_paid_delivery": true,
    "freshness_policy_required_for_paid_delivery": true,
    "external_web_search": false,
    "synthetic_fallback_score": false
  },
  "privacy": {
    "question_planning_external_llm": false,
    "raw_question_sent_to_payment_provider": false,
    "payment_proof_persisted_raw": false,
    "client_request_id_persisted_raw": false,
    "prepared_premium_payload_encrypted_at_rest": true,
    "paid_and_preflight_http_cache": "no-store",
    "transport": "https"
  },
  "boundaries": {
    "free_api_access": false,
    "free_structured_download": false,
    "financial_advice": false,
    "legal_advice": false,
    "autonomous_execution": false,
    "wallet_custody": false,
    "transaction_signing": false,
    "sanctions_screening_replacement": false,
    "counterparty_due_diligence_replacement": false,
    "raw_data_delivery": false,
    "full_physical_route_or_vessel_model": false,
    "corridor_model": "directional endpoint-composed pilot"
  },
  "commercial": {
    "launch_state": "prelaunch",
    "production_funds_authorized": false,
    "structured_data_registry_version": "structured-entitlements-v1.0.0",
    "credit_contract_version": "credits-v1.1.0",
    "free_web": "public_website_dashboard_only",
    "public_api": "not_available",
    "public_structured_data_download": "not_available",
    "commercial_structured_api": "/api/commercial/structural",
    "risk_api": "paid_private_pilot",
    "institutional_sla": "not_generally_available",
    "price_source": "authoritative_payment_challenge_or_provider_plan",
    "launch_cohort": ["coinbase_x402", "circle_gateway_x402", "nevermined"],
    "deferred_providers": {
      "goat_x402_mainnet": "manual_merchant_application_and_approval_required"
