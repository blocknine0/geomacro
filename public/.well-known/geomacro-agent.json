{
  "agent": {
    "id": "geomacro",
    "name": "GeoMacro Global Risk Intelligence Agent",
    "version": "geomacro-agent-v2",
    "description": "24/7 grounded geopolitical, macroeconomic and critical-mineral risk intelligence for software and AI agents.",
    "mode": "read_recommend_and_deliver",
    "execution_authorized": false
  },
  "categories": [
    "GEOPOLITICS",
    "MACRO",
    "CRITICAL_MINERALS"
  ],
  "geographic_scope": "global_data_driven_fail_closed",
  "discovery": {
    "a2a_card": "https://geomacro.live/.well-known/agent-card.json",
    "a2a_interface": "https://geomacro.live/api/a2a",
    "commerce_catalog": "https://geomacro.live/.well-known/geomacro-commerce.json",
    "x402": "https://geomacro.live/.well-known/x402.json",
    "openapi": "https://geomacro.live/openapi-x402.json",
    "agent_commerce_docs": "https://geomacro.live/agent-commerce.md",
    "llms": "https://geomacro.live/llms.txt"
  },
  "a2a": {
    "protocol": "A2A",
    "protocol_version": "1.0",
    "binding": "JSONRPC",
    "interface": "https://geomacro.live/api/a2a",
    "streaming": false,
    "push_notifications": false,
    "extended_agent_card": false,
    "arbitrary_outbound_targets": false,
    "execution_authorized": false
  },
  "capabilities": [
    {
      "id": "geopolitics",
      "access": "availability_first_x402",
      "topics": ["conflict_geopolitics", "sanctions_restrictions", "political_governance", "trade_corridor", "hot_topics", "risk_gate", "risk_object"],
      "availability_endpoint": "https://geomacro.live/api/x402/risk/availability",
      "paid_endpoint": "https://geomacro.live/api/x402/intelligence",
      "execution_authorized": false
    },
    {
      "id": "macro",
      "access": "availability_first_x402",
      "topics": ["macro_risk", "fx_external_risk", "sovereign_risk", "banking_financial_system", "energy_commodities", "food_agriculture", "natural_hazards"],
      "availability_endpoint": "https://geomacro.live/api/x402/risk/availability",
      "paid_endpoint": "https://geomacro.live/api/x402/intelligence",
      "execution_authorized": false
    },
    {
      "id": "critical_minerals",
      "access": "availability_first_x402",
      "topics": ["critical_minerals", "trade_corridor", "energy_commodities", "hot_topics"],
      "availability_endpoint": "https://geomacro.live/api/x402/risk/availability",
      "paid_endpoint": "https://geomacro.live/api/x402/intelligence",
      "execution_authorized": false
    },
    {
      "id": "deliverability_preflight",
      "access": "no_charge",
      "method": "POST",
      "endpoint": "https://geomacro.live/api/x402/risk/availability",
      "content_type": "application/json",
      "payment_performed": false,
      "execution_authorized": false
    }
  ],
  "grounding": {
    "stored_geomacro_intelligence": true,
    "current_public_risk_indices": true,
    "signed_risk_objects": true,
    "commercial_source_eligibility_required_for_paid_delivery": true,
    "freshness_policy_required_for_paid_delivery": true,
    "external_web_search_for_paid_delivery": false,
    "synthetic_fallback_score": false
  },
  "delivery": {
    "protocol": "x402-v2",
    "canonical_paid_endpoint": "https://geomacro.live/api/x402/intelligence",
    "availability_endpoint": "https://geomacro.live/api/x402/risk/availability",
    "payment_after_deliverability_only": true,
    "replay_protection": true,
    "stale_or_incomplete_is_not_payable": true,
    "testnet_first": true,
    "production_funds_authorized": false
  },
  "boundaries": {
    "financial_advice": false,
    "legal_advice": false,
    "autonomous_execution": false,
    "wallet_custody": false,
    "transaction_signing": false,
    "sanctions_screening_replacement": false,
    "counterparty_due_diligence_replacement": false,
    "raw_private_warehouse_delivery": false,
    "execution_authorized": false
  },
  "promotion": {
    "strategy": "free_evidence_based_discovery_only",
    "paid_ads": false,
    "paid_boosts": false,
    "unsolicited_direct_messages": false,
    "spam_automation": false,
    "claims_must_be_machine_verifiable": true,
    "preferred_free_surfaces": ["a2a_agent_card", "x402_bazaar_metadata", "github", "llms_txt", "openapi", "free_agent_directories"]
  },
  "commercial": {
    "launch_state": "testnet_prelaunch",
    "production_funds_authorized": false,
    "mainnet_activation_requires_explicit_owner_authorization": true,
    "price_source": "authoritative_runtime_payment_challenge",
    "testnet_or_sandbox_is_revenue": false
  }
}
