# Backend-only configuration. Load securely; do not commit real values.
DATABASE_URL=postgresql://geomacro_runtime:REPLACE_ME@HOST:5432/postgres
PG_CA_FILE=/absolute/path/to/provider-ca.pem
PG_LOCAL=false
SITE_ORIGIN=https://geomacro.live
PORT=3000

# Explicitly enable each rail after its configuration and acceptance checks.
PAYPAL_ENABLED=false
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_MERCHANT_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Zero/empty values intentionally fail validation. Enter your approved
# purchased-credit entitlements and plan IDs; code does not invent them.
PAYPAL_CATALOG_JSON='{"pack5":{"credits":0},"pack15":{"credits":0},"pack30":{"credits":0},"monthly9":{"credits":0,"planId":""},"monthly29":{"credits":0,"planId":""},"monthly99":{"credits":0,"planId":""}}'
PAYPAL_PROVISIONING_ID=

X402_ENABLED=false
X402_PAYEE_ADDRESS=
BASE_RPC_URL=
BASE_CONFIRMATIONS=2
X402_FACILITATOR_URL=
X402_FACILITATOR_HEADERS_JSON='{}'
SIGNING_PRIVATE_KEY_FILE=/absolute/path/to/ed25519-private.pem
SIGNING_PUBLIC_KEY_ID=
SIGNING_PUBLIC_KEYS_JSON='{"REPLACE_KEY_ID":"/absolute/path/to/ed25519-public.pem"}'
RISK_RESOLVER_MODULE=
