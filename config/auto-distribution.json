{
  "version": "1.2.0",
  "mode": "prelaunch-shadow",
  "default_dry_run": true,
  "live_publish_enabled": false,
  "canonical_public_feed": {
    "url": "https://geomacro.live/api/early-warning",
    "schema_version": "geomacro.public-early-warning-feed.v1",
    "poll_interval_minutes": 15,
    "max_items_per_poll": 5
  },
  "receipt_policy": {
    "contract_version": "early-warning-distribution-lease-v1",
    "lease_seconds": 120,
    "max_attempts_per_alert_channel": 5,
    "payload_hash_required": true,
    "ambiguous_outcome_retry": "manual_only",
    "claim_rpc": "claim_early_warning_distribution",
    "finalize_rpc": "finalize_early_warning_distribution",
    "live_worker_wired": false
  },
  "live_activation_requirements": {
    "durable_distribution_receipt_ledger": true,
    "channel_credentials_configured": true,
    "owner_launch_authorization": true,
    "source_feed_health_verified": true
  },
  "public_alert_policy": {
    "allowed_content_types": ["early_warning"],
    "required_visibility": "public",
    "allowed_statuses": ["WARNING", "CRITICAL"],
    "minimum_confidence": 0.7,
    "minimum_independent_evidence": 2,
    "require_official_or_independent_confirmation": true,
    "never_publish_fields": [
      "premium_evidence",
      "premium_analysis",
      "customer_context",
      "private_notes",
      "raw_source_content",
      "api_keys",
      "payment_proof",
      "evidence_refs",
      "source_event_ids",
      "source_risk_object_id",
      "cews_inputs",
      "cews_contributions",
      "outcome_evidence_refs"
    ]
  },
  "channels": {
    "telegram": {"enabled": true, "cost_class": "free", "max_chars": 3900},
    "discord": {"enabled": true, "cost_class": "free", "max_chars": 1900},
    "bluesky": {"enabled": true, "cost_class": "free", "max_chars": 290},
    "mastodon": {"enabled": true, "cost_class": "free", "max_chars": 450},
    "rss": {"enabled": true, "cost_class": "free", "publish_mode": "native_public_feed"},
    "linkedin": {
      "enabled": false,
      "cost_class": "approval_required",
      "reason": "Enable only after LinkedIn Community Management API approval."
    },
    "x": {
      "enabled": false,
      "cost_class": "paid",
      "reason": "Excluded from the zero-cost core. Enable only after explicit spend approval."
    }
  }
}
