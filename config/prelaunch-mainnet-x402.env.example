# Geomacro coordinated pay-per-call launch template.
# PRELAUNCH DEFAULT: all production environments and acknowledgements remain blank/false.
# Copy values into the server-side secret manager only during an explicitly approved launch.
# Never commit real credentials, private keys, API secrets or signing material.

GEOMACRO_CENTRAL_SECURITY_MODE=enforce
GEOMACRO_REAL_FUNDS_SECURITY_ACK=
GEOMACRO_COMMERCIAL_LAUNCH_ACK=
GEOMACRO_SECURITY_FINGERPRINT_PEPPER=
GEOMACRO_API_CREDENTIAL_PEPPER=

# Coinbase CDP x402 on Base mainnet. Keep environment blank before launch.
COINBASE_X402_ENVIRONMENT=
COINBASE_X402_PAY_TO=
COINBASE_X402_PRICE_USDC=0.02
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
COINBASE_X402_MAINNET_ACK=

# Circle Gateway nanopayments. Existing /api/agent/risk Arc Testnet proof stays separate.
# Initial production allowlist is Base mainnet only. Arc mainnet is intentionally not enabled.
CIRCLE_X402_ENVIRONMENT=
CIRCLE_X402_SELLER_ADDRESS=
CIRCLE_X402_PRICE_USDC=0.02
CIRCLE_X402_PRODUCTION_NETWORKS=eip155:8453
CIRCLE_X402_MAINNET_ACK=

# Nevermined. Keep environment blank before coordinated launch.
NEVERMINED_X402_ENVIRONMENT=
NEVERMINED_NVM_API_KEY=
NEVERMINED_PLAN_ID=
NEVERMINED_X402_SCHEME=nvm:erc4337
NEVERMINED_X402_NETWORK=
NEVERMINED_X402_MAX_AMOUNT=

# GOAT Flow. Testnet3 remains the safe default in the main .env.example.
# Do not set mainnet until merchant approval and live capability inspection are complete.
GOATX402_ENVIRONMENT=testnet3
GOATX402_API_URL=https://flow-api.testnet3.goat.network
GOATX402_API_KEY=
GOATX402_API_SECRET=
GOATX402_MERCHANT_ID=
GOATX402_MAINNET_COMMERCIAL_ENABLED=false

# Canonical public origin.
PUBLIC_SITE_URL=https://geomacro.live
