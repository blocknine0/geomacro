{
  "schema_version": "geomacro.private-source-derivation-policy.v1",
  "locked_by_owner": "2026-10-29",
  "ingestion": {
    "allow_any_source_as_private_research_candidate": true,
    "commercial_license_preclearance_required_to_collect": false,
    "accepts_osint_and_news_all_categories": true,
    "preservation": "OWNER_PRIVATE_ONLY",
    "observed_facts_must_not_be_treated_as_independently_corrobated_by_origin_alone": true
  },
  "transformation": {
    "output_owner": "GEOMACRO",
