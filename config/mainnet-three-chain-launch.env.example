# EIP-191 owner-signed target (2026-10-30; Etherscan signature record #340876): ONE public receiving wallet on all three EVM chains.
# Signature proves wallet control, NOT live merchant settlement or permission to transfer funds.
# Apply these owner-provided public receiver values in the server secret manager. Do not put
# wallet private keys/seed phrases in this file, requests or client code.
GEOMACRO_USDC_RECEIVER=0x95ba71d21C41bDa8bBA9533f96D25f793E4137b5
COINBASE_X402_PAY_TO=0x95ba71d21C41bDa8bBA9533f96D25f793E4137b5
CIRCLE_X402_SELLER_ADDRESS=0x95ba71d21C41bDa8bBA9533f96D25f793E4137b5

# All three values above must resolve to the same nonzero EVM address.
# These are native USDC identities, not activation or settlement evidence.
# Base: eip155:8453, 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
# Polygon: eip155:137, 0x3c499c542cEF5E3811e1192ce70d8cC03d5c3359
# Arc: eip155:5042, 0x3600000000000000000000000000000000000000

# Existing Coinbase exact adapter serves Base only. Existing Circle Gateway
# batching also remains Base-only. Neither may be relabelled as native Circle
# Facilitator support for Arc/Polygon. The native verification adapter exists,
# but settlement/status and canonical delivery integration remain separate
# acceptance work until their current credentials/readbacks are available.
COINBASE_X402_ENVIRONMENT=
COINBASE_X402_MAINNET_ACK=
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

GEOMACRO_COMMERCE_LEDGER_BACKEND=durable_object
GEOMACRO_COMMERCE_LEDGER_URL=
GEOMACRO_COMMERCE_LEDGER_TOKEN=
GEOMACRO_CENTRAL_SECURITY_MODE=enforce
GEOMACRO_REAL_FUNDS_SECURITY_ACK=
GEOMACRO_COMMERCIAL_LAUNCH_ACK=
GEOMACRO_SECURITY_FINGERPRINT_PEPPER=
GEOMACRO_API_CREDENTIAL_PEPPER=
