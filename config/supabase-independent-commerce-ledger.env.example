# Geomacro Supabase-independent paid-delivery ledger.
# Keep backend=supabase until the Durable Object worker is deployed and its
# fail-closed acceptance test passes. Then switch exactly to durable_object.
GEOMACRO_COMMERCE_LEDGER_BACKEND=supabase

# HTTPS origin of the deployed Cloudflare Worker, for example:
# https://geomacro-commerce-ledger.<account-subdomain>.workers.dev
GEOMACRO_COMMERCE_LEDGER_URL=

# Server-only shared bearer secret, minimum 32 random characters.
# Configure the exact same value as the Worker secret LEDGER_SHARED_TOKEN.
# Never prefix with VITE_, expose in browser code, commit a real value, or log it.
GEOMACRO_COMMERCE_LEDGER_TOKEN=
