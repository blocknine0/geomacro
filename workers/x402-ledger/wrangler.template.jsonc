{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "geomacro-x402-ledger",
  "main": "src/index.mjs",
  "compatibility_date": "2026-09-29",
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "geomacro-x402-ledger",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ]
}
