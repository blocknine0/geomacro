{
  "name": "geomacro-control-plane",
  "main": "src/index.mjs",
  "compatibility_date": "2026-10-03",
  "workers_dev": true,
  "vars": {
    "GEOMACRO_P0B_SOURCE_FIRST_ENABLED": "1",
    "GEOMACRO_CUSTOMER_ALLOWED_ORIGINS": "https://geomacro.live,https://geomacro.lovable.app",
    "GEOMACRO_RISK_GATE_COMMERCIAL_ACCEPTANCE": "ACCEPTED_RISK_GATE_PRICING_LEDGER",
    "RISK_GATE_SUPABASE_ACCEPTANCE": "ACCEPTED_PRIVATE_RISK_GATE_DAILY",
    "RISK_GATE_SUPABASE_URL": "https://ymjuwuvbialsevfawvvq.supabase.co",
    "EMAIL_FROM_ADDRESS": "auth@geomacro.live",
    "GEOMACRO_P0B_ADMISSION_ACTIVE": "0",
    "GEOMACRO_P1_FANOUT_ENABLED": "1",
    "GEOMACRO_P1_BUNDLED_LEASES_ENABLED": "0",
    "RISK_GATE_COUNTRY_SCOPE": "HOT50",
    "RISK_STREAM_ACTIVE": "0",
    "STREAM_INGESTION_ENABLED": "false",
    "STREAM_MODE": "DISABLED"
  },
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "cache": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "geomacro-control-plane",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "RISK_STREAM_PRIVATE_R2",
      "bucket_name": "geomacro-risk-stream-private"
    }
  ],
  "routes": [
    {
      "pattern": "api.geomacro.live",
      "custom_domain": true,
      "zone_name": "geomacro.live"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "INGEST_QUEUE",
        "queue": "geomacro-ingestion-spool"
      },
      {
        "binding": "SOURCE_POLL_QUEUE",
        "queue": "geomacro-source-poll"
      },
      {
        "binding": "RISK_STREAM_QUEUE",
        "queue": "geomacro-risk-stream"
      },
      {
        "binding": "RISK_STREAM_DELIVERY_QUEUE",
        "queue": "geomacro-risk-stream-delivery"
      }
    ],
    "consumers": [
      {
        "queue": "geomacro-ingestion-spool",
        "max_batch_size": 25,
        "max_batch_timeout": 15,
        "max_retries": 10,
        "dead_letter_queue": "geomacro-ingestion-dead-letter",
        "retry_delay": 60
      },
      {
        "queue": "geomacro-risk-stream",
        "max_batch_size": 10,
        "max_batch_timeout": 2,
        "max_retries": 8,
        "dead_letter_queue": "geomacro-risk-stream-dlq",
        "max_concurrency": 4
      },
      {
        "queue": "geomacro-risk-stream-delivery",
        "max_batch_size": 20,
        "max_batch_timeout": 2,
        "max_retries": 8,
        "dead_letter_queue": "geomacro-risk-stream-delivery-dlq",
        "max_concurrency": 4
      },
      {
        "queue": "geomacro-source-poll",
        "max_batch_size": 1,
        "max_batch_timeout": 2,
        "max_retries": 1,
        "dead_letter_queue": "geomacro-source-poll-dlq",
        "retry_delay": 30,
        "max_concurrency": 10
      }
    ]
  }
}
