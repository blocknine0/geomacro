# Protected Geomacro flash endpoints
GEOMACRO_FLASH_INGEST_URL=https://qogpagklwbfdmrgnrhzi.supabase.co/functions/v1/live-flash-ingest
GEOMACRO_FLASH_CORROBORATE_URL=https://qogpagklwbfdmrgnrhzi.supabase.co/functions/v1/live-flash-corroborate
GEOMACRO_FLASH_INGEST_TOKEN=CHANGE_ME
FLASH_CORROBORATION_INTERVAL_SECONDS=15

# Telegram MTProto user session
# Runtime admission is machine-governed by live_telegram_channel_registry.
# The worker discovers ACTIVE public channels from the registry automatically.
TELEGRAM_ENABLED=false
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=CHANGE_ME
TELEGRAM_SESSION=CHANGE_ME

# Optional fallback list. With auto-discovery enabled, the registry is authoritative.
TELEGRAM_AUTO_DISCOVERY=true
TELEGRAM_CHANNELS=
TELEGRAM_SOURCE_RELIABILITY_JSON={}
TELEGRAM_MAX_BODY_CHARS=6000

# Fast RSS/official-feed polling
BREAKING_RSS_ENABLED=true
BREAKING_RSS_POLL_SECONDS=45
BREAKING_RSS_BOOTSTRAP_MAX_ITEMS=25

# Optional override. If omitted, the worker uses the governed defaults:
# Al Jazeera RSS, Federal Reserve press RSS, ForexLive RSS, USGS Minerals News RSS.
# BREAKING_RSS_FEEDS_JSON=[]

BREAKING_FEED_USER_AGENT=Geomacro/1.0 (+https://geomacro.live; contact=contact@geomacro.live)

GEOMACRO_FLASH_ARCHIVE_URL=https://qogpagklwbfdmrgnrhzi.supabase.co/functions/v1/live-flash-archive
FLASH_ARCHIVE_INTERVAL_SECONDS=120
