    "PREDGE_PAID_CUSTOMER_ENTITLEMENT_VERIFIED": "0",
    "PREDGE_PAID_GO_LIVE_APPROVED": "0"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "geomacro-control-plane",
