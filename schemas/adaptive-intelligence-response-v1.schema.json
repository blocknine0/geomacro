{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://geomacro.live/schemas/adaptive-intelligence-response-v1.schema.json",
  "title": "Geomacro Adaptive Intelligence Response v1",
  "description": "Stable outer response contract for adaptive Geomacro intelligence. Inner modules are selected by the governed query plan and are delivered only after full required-module availability checks. Current natural-language requests return versioned current state and redacted structural developments; source identity and raw article material are not part of the commercial payload.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "product",
    "request_id",
    "client_request_id",
    "query_plan_hash",
    "question_interpretation",
    "subjects",
    "as_of",
    "analysis",
    "answer",
    "current_state",
    "structural",
    "hot_topics",
    "risk_gate",
    "signed_risk_objects",
    "gri_context",
    "methodology",
    "limitations",
    "execution_authorized",
    "delivered_product_hash"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "geomacro.adaptive-intelligence-response.v1"
    },
    "product": {
      "type": "string",
      "const": "geomacro_adaptive_risk_intelligence_v1"
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "client_request_id": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "minLength": 4,
          "maxLength": 128
        }
      ]
    },
    "query_plan_hash": {
      "$ref": "#/$defs/sha256"
    },
    "question_interpretation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "normalized_question",
        "intent",
        "topics",
        "required_modules",
        "ranking",
        "change"
      ],
      "properties": {
        "normalized_question": {
          "type": [
            "string",
            "null"
          ]
        },
        "intent": {
          "$ref": "#/$defs/intent"
        },
        "topics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/topic"
          },
          "uniqueItems": true
        },
        "required_modules": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "ranking": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "metric",
                "order"
              ],
              "properties": {
                "metric": {
                  "const": "risk_object_score"
                },
                "order": {
                  "enum": [
                    "high_to_low",
                    "low_to_high"
                  ]
                },
                "limit": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 25
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "change": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "baseline"
              ],
              "properties": {
                "baseline": {
                  "const": "previous_published"
                }
              },
              "additionalProperties": false
            }
          ]
        }
      }
    },
    "subjects": {
      "type": "array",
      "minItems": 1,
      "maxItems": 25,
      "items": {
        "$ref": "#/$defs/subject"
      }
    },
    "as_of": {
      "type": "string",
      "format": "date-time"
    },
    "analysis": {
      "$ref": "#/$defs/analysis"
    },
    "structural": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "subject",
          "intelligence",
          "evidence_summary",
          "serving"
        ],
        "properties": {
          "subject": {
            "$ref": "#/$defs/subject"
          },
          "intelligence": {
            "type": "object"
          },
          "serving": {
            "type": "object",
            "required": [
              "layer",
              "warehouse_methodology_status",
              "composition_method",
              "route_modeling_status",
              "direct_evidence_status"
            ],
            "additionalProperties": true
          },
          "evidence_summary": {
            "type": "object",
            "required": [
              "observation_count",
              "available_dimensions",
              "latest_observed_at"
            ],
            "properties": {
              "observation_count": {
                "type": "integer",
                "minimum": 0
              },
              "available_dimensions": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "latest_observed_at": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "hot_topics": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "risk_gate": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "subject",
          "result"
        ],
        "properties": {
          "subject": {
            "$ref": "#/$defs/subject"
          },
          "result": {
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    },
    "signed_risk_objects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "subject",
          "object"
        ],
        "properties": {
          "subject": {
            "$ref": "#/$defs/subject"
          },
          "object": {
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    },
    "gri_context": {
      "type": [
        "object",
        "null"
      ]
    },
    "methodology": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "query_schema_version",
        "response_schema_version",
        "product_contract_version",
        "current_event_delivery",
        "intent_method",
        "ranking_metric",
        "change_baseline",
        "pricing_phase",
        "price_usdc"
      ],
      "properties": {
        "query_schema_version": {
          "const": "geomacro.agent-query.v1"
        },
        "response_schema_version": {
          "const": "geomacro.adaptive-intelligence-response.v1"
        },
        "current_event_delivery": {
          "type": [
            "string",
            "null"
          ]
        },
        "intent_method": {
          "const": "deterministic-governed-v1"
        },
        "ranking_metric": {
          "enum": [
            "risk_object_score",
            null
          ]
        },
        "change_baseline": {
          "enum": [
            "previous_published",
            null
          ]
        },
        "product_contract_version": {
          "const": "geomacro.intelligence-contract.v1"
        },
        "pricing_phase": {
          "const": "EARLY_ADOPTION_10K"
        },
        "price_usdc": {
          "const": "0.05"
        }
      }
    },
    "limitations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "execution_authorized",
        "missing_is_never_zero_risk",
        "only_prechecked_required_modules_delivered",
        "current_event_raw_source_material_redistributed",
        "corridor_route_modeling_may_be_unavailable"
      ],
      "properties": {
        "execution_authorized": {
          "const": false
        },
        "missing_is_never_zero_risk": {
          "const": true
        },
        "only_prechecked_required_modules_delivered": {
          "const": true
        },
        "current_event_raw_source_material_redistributed": {
          "const": false
        },
        "corridor_route_modeling_may_be_unavailable": {
          "type": "boolean"
        }
      }
    },
    "execution_authorized": {
      "const": false
    },
    "delivered_product_hash": {
      "$ref": "#/$defs/sha256"
    },
    "payment": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "required": {
          "const": true
        },
        "provider": {
          "const": "coinbase_cdp_x402"
        },
        "asset": {
          "const": "USDC"
        },
        "amount_atomic": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "amount_usdc": {
          "type": "string"
        },
        "network": {
          "type": "string"
        },
        "settlement_reference": {
          "type": [
            "string",
            "null"
          ]
        },
        "idempotent_replay": {
          "type": "boolean"
        }
      }
    },
    "current_state": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "answer": {
      "type": "object",
      "required": [
        "status",
        "headline",
        "what_changed",
        "why_it_matters"
      ],
      "properties": {
        "status": {
          "type": "string"
        },
        "headline": {
          "type": "string"
        },
        "what_changed": {
          "type": "array"
        },
        "why_it_matters": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "iso3": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "topic": {
      "type": "string",
      "enum": [
        "sovereign_risk",
        "macro_risk",
        "fx_external_risk",
        "sanctions_restrictions",
        "conflict_geopolitics",
        "trade_corridor",
        "energy_commodities",
        "critical_minerals",
        "political_governance",
        "banking_financial_system",
        "food_agriculture",
        "natural_hazards",
        "hot_topics",
        "risk_gate",
        "risk_object",
        "gri_context"
      ]
    },
    "intent": {
      "type": "string",
      "enum": [
        "single_subject",
        "comparison",
        "ranking_filter",
        "corridor",
        "change_since",
        "audit",
        "risk_gate"
      ]
    },
    "subject": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "country_iso3"
          ],
          "properties": {
            "type": {
              "const": "country"
            },
            "country_iso3": {
              "$ref": "#/$defs/iso3"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "origin_country_iso3",
            "destination_country_iso3"
          ],
          "properties": {
            "type": {
              "const": "corridor"
            },
            "origin_country_iso3": {
              "$ref": "#/$defs/iso3"
            },
            "destination_country_iso3": {
              "$ref": "#/$defs/iso3"
            }
          }
        }
      ]
    },
    "analysis": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "subject"
          ],
          "properties": {
            "type": {
              "const": "single_subject"
            },
            "subject": {
              "$ref": "#/$defs/subject"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "atomic_subject_coverage",
            "compared_subject_count",
            "compared_modules",
            "missing_subjects"
          ],
          "properties": {
            "type": {
              "const": "comparison"
            },
            "atomic_subject_coverage": {
              "const": true
            },
            "compared_subject_count": {
              "type": "integer",
              "minimum": 2
            },
            "compared_modules": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "missing_subjects": {
              "type": "array",
              "maxItems": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "metric",
            "order",
            "complete_subject_coverage",
            "evaluated_subject_count",
            "rows"
          ],
          "properties": {
            "type": {
              "const": "ranking_filter"
            },
            "metric": {
              "const": "risk_object_score"
            },
            "order": {
              "enum": [
                "high_to_low",
                "low_to_high"
              ]
            },
            "complete_subject_coverage": {
              "const": true
            },
            "evaluated_subject_count": {
              "type": "integer",
              "minimum": 2
            },
            "rows": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "rank",
                  "subject",
                  "risk_object_id",
                  "score",
                  "label",
                  "confidence",
                  "delta",
                  "methodology_version",
                  "verification_status"
                ],
                "additionalProperties": false,
                "properties": {
                  "rank": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "subject": {
                    "$ref": "#/$defs/subject"
                  },
                  "risk_object_id": {
                    "type": "string"
                  },
                  "score": {
                    "type": "number"
                  },
                  "label": {
                    "type": "string"
                  },
                  "confidence": {
                    "type": "number"
                  },
                  "delta": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "methodology_version": {
                    "type": "string"
                  },
                  "verification_status": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "baseline",
            "subject",
            "risk_object_id",
            "previous_score",
            "current_score",
            "delta",
            "direction",
            "drivers",
            "methodology_version"
          ],
          "properties": {
            "type": {
              "const": "change_since"
            },
            "baseline": {
              "const": "previous_published"
            },
            "subject": {
              "$ref": "#/$defs/subject"
            },
            "risk_object_id": {
              "type": "string"
            },
            "previous_score": {
              "type": "number"
            },
            "current_score": {
              "type": "number"
            },
            "delta": {
              "type": "number"
            },
            "direction": {
              "type": "string"
            },
            "drivers": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "methodology_version": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "independently_verifiable",
            "signed_object_count",
            "objects"
          ],
          "properties": {
            "type": {
              "const": "audit"
            },
            "independently_verifiable": {
              "const": true
            },
            "signed_object_count": {
              "type": "integer",
              "minimum": 1
            },
            "objects": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "directional",
            "subject"
          ],
          "properties": {
            "type": {
              "const": "corridor"
            },
            "directional": {
              "const": true
            },
            "subject": {
              "$ref": "#/$defs/subject"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "advisory_only",
            "execution_authorized",
            "action_context"
          ],
          "properties": {
            "type": {
              "const": "risk_gate"
            },
            "advisory_only": {
              "const": true
            },
            "execution_authorized": {
              "const": false
            },
            "action_context": {
              "type": "object"
            }
          }
        }
      ]
    }
  }
}
