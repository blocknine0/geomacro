# ---- Server-only secrets (never prefix with VITE_) ----
# Lovable AI Gateway — managed by Lovable; rotate via the platform.
LOVABLE_API_KEY=
# and the Autonomous Oracle / Agent Arena live news context.
# Permanent classifier-provider chain for public-source intelligence:
# Groq -> Gemini -> Mistral -> Cerebras -> fail closed.
# Missing keys are skipped automatically; every successful assessment records
# the actual classification_provider and classification_model.
GROQ_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
# Cerebras is also used by some legacy/agent workflows outside news ingestion.
CEREBRAS_API_KEY=

# ---- Authoritative application Supabase ----
# Production database authority is the external Geomacro Supabase project
# ldpwajisioljyjtojvfx. Lovable/hosting-injected VITE_SUPABASE_* values are NOT
# part of the production data contract and must never select the database.
#
# APP_* is the application-runtime naming used by the hosted SSR/API layer.
# SUPABASE_* is retained for trusted ingestion/ops scripts and GitHub Actions.
# In production both URL variables must identify the same authoritative project,
# and both service-role variables should carry the same server-only service key.
APP_SUPABASE_URL=
APP_SUPABASE_ANON_KEY=
APP_SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Testnet Developer API live runtime ----
# Required in the hosted SSR/API runtime before public Testnet pay-per-call launch.
# Receiver is a PUBLIC EVM address only. Never configure a private key here.
TESTNET_USDC_RECEIVER_ADDRESS=
# Each RPC must be an HTTPS endpoint for exactly the named Testnet chain.
# Runtime verifies eth_chainId before accepting a payment proof.
TESTNET_RPC_ARC=
TESTNET_RPC_BASE_SEPOLIA=
TESTNET_RPC_POLYGON_AMOY=
# Canonical public origin used by share-card URLs. Core API routes also default
# to geomacro.live, but production should set this explicitly.
PUBLIC_SITE_URL=https://geomacro.live

# Private historical/structural warehouse used by server-only evidence context.
# Required for the country/corridor digest/profile and Risk Gate bundle portions
# of the full eight-capability Testnet API surface. Never expose either value
# with a VITE_ prefix.
HISTORICAL_SUPABASE_URL=
HISTORICAL_SUPABASE_SERVICE_ROLE_KEY=

GUARDIAN_API_KEY=

# ---- Agentic-commerce technical proof (Arc Testnet only) ----
# Dedicated x402 seller/pay-to address used by POST /api/agent/risk.
# Must be a valid 0x-prefixed EVM address. Keep this separate from unrelated
# application treasuries/contracts so the technical proof has an explicit owner.
# This address is not a private key and does not authorize Risk Gate execution.
CIRCLE_X402_SELLER_ADDRESS=

# ---- Coinbase CDP x402 + Bazaar (Base Sepolia accepted; Base mainnet PREPARED BUT LOCKED) ----
# Leave COINBASE_X402_ENVIRONMENT blank to disable this rail completely.
# testnet = Base Sepolia. production = Base mainnet with real USDC.
# IMPORTANT: preparing the production values below does NOT authorize launch.
COINBASE_X402_ENVIRONMENT=
# Public EVM receiver address only. For production use a dedicated Geomacro
# settlement/revenue address whose ownership and recovery procedure are verified.
# Never put a private key or seed phrase in source control or runtime variables.
COINBASE_X402_PAY_TO=
# Approved production launch price is 0.02 USDC/call. Base Sepolia historical
# acceptance evidence remains at 0.05 test USDC and must not be rewritten.
COINBASE_X402_PRICE_USDC=0.02
# Coinbase Developer Platform credentials are server-only. Production credentials
# may be staged in the deployment secret store, but never commit their values.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
# FINAL REAL-FUNDS GATE. KEEP THIS BLANK while preparing mainnet.
# Only set after explicit owner authorization to activate real-USDC settlement.
# Allowed activation value: I_ACCEPT_REAL_USDC
COINBASE_X402_MAINNET_ACK=

# ---- GOAT Flow partner pilot (isolated from general billing) ----
# Geomacro has GOAT Flow Testnet3 merchant access. Keep all merchant credentials
# server-only and never prefix them with VITE_. Do not paste real values into
# source control, issues, screenshots or browser code.
#
# testnet3 -> official partner/funding engineering proof, never revenue
# mainnet  -> production commercial path, disabled until explicit launch gates
GOATX402_ENVIRONMENT=testnet3
GOATX402_API_URL=https://flow-api.testnet3.goat.network
GOATX402_API_KEY=
GOATX402_API_SECRET=
GOATX402_MERCHANT_ID=

# Separate Geomacro bearer token for /api/goat/pilot/* testers. This is NOT a
# GOAT merchant secret and grants no wallet/transaction/execution authority.
# Generate at least 32 random bytes and rotate independently.
GOATX402_PILOT_ACCESS_TOKEN=

# The commercial SKU is risk_preflight_v1. During Testnet3 the actual payment
# amount is a test amount only. Configure it in token atomic units; do not call
# this institutional/commercial pricing and do not count Testnet3 payments as
# revenue. Token contract is NOT configured here: runtime resolves exactly one
# merchant-supported token from GOAT's trusted merchant capability response.
GOATX402_PILOT_TOKEN_SYMBOL=USDC
