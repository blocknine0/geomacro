# ---- Server-only secrets (never prefix with VITE_) ----
# Lovable AI Gateway — managed by Lovable; rotate via the platform.
LOVABLE_API_KEY=
# and the Autonomous Oracle / Agent Arena live news context.
# Permanent classifier-provider chain for public-source intelligence:
# Groq -> Gemini -> Mistral -> Cerebras -> fail closed.
# Missing keys are skipped automatically; every successful assessment records
# the actual classification_provider and classification_model.
GROQ_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
# Cerebras is also used by some legacy/agent workflows outside news ingestion.
CEREBRAS_API_KEY=
# External Supabase project. Public app reads use APP_*; trusted ingestion writes
# use SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY (server-only).
APP_SUPABASE_URL=
APP_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Private historical/structural warehouse used by server-only evidence context.
# Never expose either value with a VITE_ prefix.
HISTORICAL_SUPABASE_URL=
HISTORICAL_SUPABASE_SERVICE_ROLE_KEY=

GUARDIAN_API_KEY=

# ---- Agentic-commerce technical proof (Arc Testnet only) ----
# Dedicated x402 seller/pay-to address used by POST /api/agent/risk.
# Must be a valid 0x-prefixed EVM address. Keep this separate from unrelated
# application treasuries/contracts so the technical proof has an explicit owner.
# This address is not a private key and does not authorize Risk Gate execution.
CIRCLE_X402_SELLER_ADDRESS=

# ---- News-ingestion tuning (optional; defaults shown) ----
CLASSIFIER_PROVIDER_ORDER=groq,gemini,mistral,cerebras
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_MODEL=gemini-3.8-flash
GEMINI_MODEL_ORDER=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash-lite
MISTRAL_MODEL=mistral-small-2603
CEREBRAS_MODEL=gpt-oss-120b
GROQ_BATCH_SIZE=2
GROQ_BATCH_DELAY_MS=4000
GROQ_MAX_RETRIES=5
GROQ_MAX_REQUESTS_PER_RUN=30
GROQ_MIN_REMAINING_REQUESTS=2
GROQ_MIN_REMAINING_TOKENS=1500
GROQ_MAX_WAIT_MS=90000
NEWS_QUERY_DELAY_MS=800
NEWS_MAX_RETRIES=3
MAX_CANDIDATES_PER_CATEGORY=18
MAX_ARTICLE_AGE_MS=259200000
MIN_CONFIDENCE=60
MIN_SEVERITY=30

# GRI publication is intentionally NOT coupled to news ingestion.
# The dedicated publish-gri.yml workflow is the only canonical live publisher.
# GitHub repository variables (not secrets):
# GRI_PUBLISH_ENABLED=false       # set true only after first verified baseline
# GRI_VALIDATION_ENABLED=false    # set true after benchmark/validation setup

# ---- Public, build-time config (safe to expose) ----
# Force a specific Arc network. Leave unset for auto (mainnet when live,
# else testnet). Accepted values: mainnet | testnet
VITE_ARC_NETWORK=

# Guardian discovery request budget.
# Full query corpus is retained and rotated deterministically.
GUARDIAN_QUERY_BUDGET_PER_CATEGORY=10
GUARDIAN_QUERY_ROTATION_HOURS=2

# Geomacro Risk Object issuer signing.
# Private key: base64-encoded PKCS#8 DER Ed25519 key.
# Public key: base64-encoded SPKI DER Ed25519 key.
# key_id must be stable and unique for each signing-key generation.
RISK_OBJECT_SIGNING_KEY_ID=
RISK_OBJECT_SIGNING_PRIVATE_KEY_PKCS8_B64=
RISK_OBJECT_SIGNING_PUBLIC_KEY_SPKI_B64=

# Optional validity window for NEW signatures produced by the current key.
# ISO-8601 timestamps. Signing fails closed if a GRO generated_at is outside it.
RISK_OBJECT_SIGNING_KEY_NOT_BEFORE=
RISK_OBJECT_SIGNING_KEY_NOT_AFTER=

# Public verification-key registry retained across rotation.
#
# Legacy format remains accepted:
# {"geomacro-risk-2026-01":"<base64-spki>"}
#
# Preferred production format records lifecycle state and optional validity:
# {
#   "geomacro-risk-2026-01": {
#     "public_key_spki_b64": "<base64-spki>",
#     "status": "retired",
#     "not_before": "2026-01-01T00:00:00.000Z",
#     "not_after": "2026-06-30T23:59:59.999Z"
#   },
#   "geomacro-risk-2026-07": {
#     "public_key_spki_b64": "<base64-spki>",
#     "status": "active",
#     "not_before": "2026-07-01T00:00:00.000Z"
#   }
# }
#
# Allowed statuses:
# - active: current/usable verification key
# - retired: no longer used for new signing; historical signatures remain valid
# - revoked: signatures fail verification
#
# /api/risk-object-keys exposes only public verification material and lifecycle
# metadata for external/customer verification. /api/risk-gate-readiness reports
# coarse readiness only and never returns private key/configuration material.
RISK_OBJECT_VERIFY_KEYS_JSON={}
